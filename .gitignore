# ============================================================================
# 千秋策 (Millennia Stratagem) · 仓库根 .gitignore
#
# 仓库结构：
#   /                     设计文档、数据表、生成/校验脚本
#   /千秋策/              Unity 工程（Assets / Packages / ProjectSettings）
#
# 【重要】Unity 的忽略规则必须带 /千秋策/ 前缀。
# 网上通用的 Unity.gitignore 都是按「工程就在仓库根目录」写的（如 /[Ll]ibrary/），
# 那种写法在这里【完全不生效】—— 一旦 git add . 就会把 1.3 GB 的 Library/ 连同
# 单个 124 MB 的 dylib 一起提交，GitHub 会直接拒收（单文件上限 100 MB）。
# 下面同时保留了两套规则：根目录版 + /千秋策/ 版，工程将来挪位置也不会漏。
# ============================================================================

# ---------------------------- Unity 自动生成 ----------------------------
# Library 是资源导入缓存，换台机器打开工程会自己重建，本工程里它有 1.3 GB
# Temp / obj / Logs / UserSettings 同理，都是本机状态
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ss]erverData/
/[Ee]xportedObj/
/[Bb]uild/
/[Bb]uilds/
.utmp/

/千秋策/[Ll]ibrary/
/千秋策/[Tt]emp/
/千秋策/[Oo]bj/
/千秋策/[Ll]ogs/
/千秋策/[Uu]ser[Ss]ettings/
/千秋策/[Mm]emoryCaptures/
/千秋策/[Rr]ecordings/
/千秋策/[Ss]erverData/
/千秋策/[Ee]xportedObj/
/千秋策/[Bb]uild/
/千秋策/[Bb]uilds/
/千秋策/.utmp/

# Unity 崩溃报告
sysinfo.txt
mono_crash.*
/千秋策/sysinfo.txt
/千秋策/mono_crash.*

# ---------------------------- IDE / 编辑器 ----------------------------
# 由 Unity 或 IDE 自动生成，而且经常带本机绝对路径
.vs/
.vscode/
.idea/
.consulo/
.gradle/
ExportedObj/

/千秋策/.vs/
/千秋策/.vscode/
/千秋策/.idea/
/千秋策/.consulo/
/千秋策/.gradle/

# 自动生成的解决方案与工程文件（Unity 会重新生成）
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.DotSettings.user

# ---------------------------- 构建产物 ----------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties

# ---------------------------- 美术源文件 ----------------------------
# Unity 能直接导入 Blender 工程，*.blend1 只是 Blender 的自动备份
*.blend1
*.blend1.meta

# ------------------- Addressables / Visual Scripting / 测试 -------------------
# 这些是 Unity 自动生成或按账号下载的，不入库
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

/千秋策/[Aa]ssets/AddressableAssetsData/link.xml*
/千秋策/[Aa]ssets/Addressables_Temp*
/千秋策/[Aa]ssets/StreamingAssets/aa*
/千秋策/[Aa]ssets/[Ss]ceneDependencyCache*
/千秋策/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/千秋策/[Aa]ssets/Plugins/Editor/JetBrains*
/千秋策/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/千秋策/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/千秋策/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/千秋策/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ---------------------------- 日志 / 临时文件 ----------------------------
*.log
*.tmp

# ============================================================================
# 下面是这个仓库自己的规则
# ============================================================================

# 数据表/文档的自动备份，不推送（正本 数据表demo.xlsx 照常入库）
*.bak
*.orig
*~

# 顺手截的图，不属于工程内容。
# 如果这张图确实要跟着仓库走：git add -f 无标题.png
无标题.png

# Python 工具（build_*.py / _final_check.py）产生的缓存
__pycache__/
*.py[cod]
.venv/
venv/
